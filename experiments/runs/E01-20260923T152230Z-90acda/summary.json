  "memory": {
    "grid2_external": [
      "classstate：对象状态累积：实例属性与类属性混淆、状态未更新、副作用与返回值不一致",
      "dictmiss：缺失键与计数初始化：默认值语义、累加被覆盖、缺失路径的返回",
      "errorcontract：输入契约：非法或越界输入应当返回什么，而不是抛什么",
      "mutabledefault：共享可变状态：可变默认参数与模块级容器的累积与别名",
      "offbyone：边界与差一：区间端点含/不含、循环上界",
      "recursionbase：递归基例与终止：基线取值、递归参数不收敛、嵌套未展开",
      "sortkey：排序键与稳定性：键取错字段、缺次级键、反向用错位置",
      "strindex：字符串索引与切片：索引方向、切分方式、大小写、端点字符"
    ],
    "grid4_lessons": [
      {
        "index": 0,
        "text": "有状态类应在实例内初始化状态，方法修改后返回最新值，并用连续调用测试累加逻辑。",
        "source_task": "classstate-01",
        "source_family": "classstate",
        "source_verdict": true
      },
      {
        "index": 1,
        "text": "pop() 必须移除并返回栈顶，不能只返回，否则 items 不会更新。",
        "source_task": "classstate-02",
        "source_family": "classstate",
        "source_verdict": false
      },
      {
        "index": 2,
        "text": "做词频统计时，遇到重复词要累加计数，而不是每次都赋值为 1。",
        "source_task": "dictmiss-01",
        "source_family": "dictmiss",
        "source_verdict": false
      },
      {
        "index": 3,
        "text": "分组时用字典累计列表，遍历原序列即可保持组内顺序，空输入自然得到空字典。",
        "source_task": "dictmiss-02",
        "source_family": "dictmiss",
        "source_verdict": true
      },
      {
        "index": 4,
        "text": "实现除法前先确认除零与返回类型，零除返回 None，普通结果保持浮点，并用边界用例自测。",
        "source_task": "errorcontract-01",
        "source_family": "errorcontract",
        "source_verdict": true
      },
      {
        "index": 5,
        "text": "转换失败要捕获 TypeError/ValueError 并返回 default，不能让异常泄漏。",
        "source_task": "errorcontract-02",
        "source_family": "errorcontract",
        "source_verdict": true
      },
      {
        "index": 6,
        "text": "可变默认参数用 None 占位，并先复制输入再修改，确保无副作用、调用互不影响。",
        "source_task": "mutabledefault-01",
        "source_family": "mutabledefault",
        "source_verdict": true
      },
      {
        "index": 7,
        "text": "默认参数勿用可变集合；缺省时用 None，进入函数再新建并复制输入，避免跨调用共享状态。",
        "source_task": "mutabledefault-02",
        "source_family": "mutabledefault",
        "source_verdict": true
      }
    ]
  }
